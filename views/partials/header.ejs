<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0" />
    <meta name="theme-color" content="#FB7701" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <title>PACKBANG.COM | Factory-Direct Packaging & eCommerce Supplies</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-3.7.1.min.js"></script>

    <style>
        :root {
            --temu-orange: #FB7701;
            --temu-orange-hover: #E06400;
            --temu-orange-light: #FFF4EB;
            --temu-dark: #111111;
            --temu-text: #222222;
            --temu-muted: #666666;
            --temu-border: #EEEEEE;
            --temu-bg: #F7F8FA;
            --temu-red: #E02020;
            --temu-green: #00A854;
        }

        *, *::before, *::after {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            box-sizing: border-box;
        }

        body {
            font-family: 'Plus Jakarta Sans', system-ui, -apple-system, sans-serif;
            margin: 0;
            padding: 0;
            background: var(--temu-bg);
            color: var(--temu-text);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            width: 100%;
            max-width: 100vw;
            overflow-x: hidden;
            position: relative;
            box-sizing: border-box;
        }

        /* =========================================================
           TEMU-STYLE TOP BENEFIT STRIP
           ========================================================= */
        .temu-top-strip {
            background: #0F172A;
            color: #E2E8F0;
            font-size: 0.78rem;
            padding: 7px 20px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            font-weight: 500;
        }

        .top-strip-items {
            display: flex;
            align-items: center;
            gap: 24px;
            margin: 0 auto;
            flex-wrap: wrap;
            justify-content: center;
        }

        .top-strip-item {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .top-strip-item i {
            color: var(--temu-orange);
            font-size: 0.85rem;
        }

        .top-strip-item strong {
            color: #FFFFFF;
        }

        /* =========================================================
           TEMU-STYLE MAIN NAVBAR
           ========================================================= */
        .main-navbar {
            background: #FFFFFF;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 12px rgba(0, 0, 0, 0.06);
            width: 100%;
            max-width: 100vw;
            left: 0;
            right: 0;
            border-bottom: 1px solid #ECECEC;
            box-sizing: border-box;
        }

        .navbar-row {
            display: flex;
            align-items: center;
            gap: 18px;
            width: 100%;
            max-width: 1320px;
            margin: 0 auto;
            padding: 12px 24px;
            box-sizing: border-box;
        }

        .navbar-row-top {
            padding-bottom: 10px;
        }

        .navbar-row-bottom {
            padding-top: 8px;
            padding-bottom: 8px;
            border-top: 1px solid #F1F1F1;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 16px;
            background: #FAFAFA;
        }

        /* Brand Logo */
        .nav-brand-container {
            display: flex;
            align-items: center;
            gap: 10px;
            text-decoration: none;
            flex-shrink: 0;
        }

        .header-logo {
            height: 38px;
            width: auto;
            object-fit: contain;
            border-radius: 6px;
        }

        .nav-brand {
            font-size: 1.55rem;
            font-weight: 900;
            color: var(--temu-orange);
            letter-spacing: -0.5px;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .nav-brand-badge {
            background: #111111;
            color: #FFFFFF;
            font-size: 0.62rem;
            font-weight: 800;
            padding: 2px 6px;
            border-radius: 4px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }

        /* Search Box (Temu Style) */
        .header-search-box {
            flex: 1;
            max-width: 650px;
            position: relative;
            display: flex;
            align-items: center;
        }

        .search-input-wrap {
            width: 100%;
            display: flex;
            align-items: center;
            background: #F4F5F7;
            border: 2px solid var(--temu-orange);
            border-radius: 30px;
            overflow: hidden;
            transition: all 0.2s ease;
        }

        .search-input-wrap:focus-within {
            box-shadow: 0 0 0 3px rgba(251, 119, 1, 0.2);
            background: #FFFFFF;
        }

        .search-icon-placeholder {
            padding-left: 16px;
            color: #888888;
            font-size: 0.95rem;
        }

        #globalProductSearch {
            width: 100%;
            padding: 10px 14px;
            border: none;
            outline: none;
            background: transparent;
            font-size: 0.92rem;
            font-family: inherit;
            color: var(--temu-text);
        }

        .search-submit-btn {
            background: var(--temu-orange);
            color: #FFFFFF;
            border: none;
            padding: 10px 22px;
            font-weight: 700;
            font-size: 0.92rem;
            cursor: pointer;
            transition: background 0.2s ease;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .search-submit-btn:hover {
            background: var(--temu-orange-hover);
        }

        /* Right Actions */
        .navbar-actions {
            display: flex;
            align-items: center;
            gap: 16px;
            margin-left: auto;
            flex-shrink: 0;
        }

        .nav-seller-pill {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: var(--temu-orange-light);
            color: var(--temu-orange);
            font-weight: 700;
            font-size: 0.8rem;
            padding: 6px 14px;
            border-radius: 20px;
            text-decoration: none;
            border: 1px solid rgba(251, 119, 1, 0.3);
            transition: all 0.2s;
        }

        .nav-seller-pill:hover {
            background: var(--temu-orange);
            color: #FFFFFF;
            transform: translateY(-1px);
        }

        /* Cart Link */
        .nav-cart-link {
            position: relative;
            display: flex;
            align-items: center;
            gap: 8px;
            color: var(--temu-dark);
            text-decoration: none;
            padding: 8px 14px;
            border-radius: 20px;
            font-weight: 700;
            font-size: 0.92rem;
            transition: background 0.2s;
            border: 1px solid transparent;
        }

        .nav-cart-link:hover {
            background: #F4F5F7;
            border-color: #E2E8F0;
        }

        .nav-cart-icon-wrap {
            position: relative;
            display: flex;
            align-items: center;
            font-size: 1.25rem;
            color: var(--temu-dark);
        }

        .cart-badge {
            position: absolute;
            top: -8px;
            right: -10px;
            background: var(--temu-orange);
            color: white;
            font-size: 0.7rem;
            font-weight: 800;
            min-width: 18px;
            height: 18px;
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 0 4px;
            box-shadow: 0 2px 6px rgba(251, 119, 1, 0.4);
        }

        .cart-badge.zero {
            display: none;
        }

        /* User Menu & Login */
        .btn-login {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            background: #111111;
            color: #FFFFFF;
            padding: 8px 18px;
            border-radius: 20px;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.88rem;
            transition: all 0.2s;
        }

        .btn-login:hover {
            background: #333333;
            transform: translateY(-1px);
        }

        .user-menu {
            position: relative;
        }

        .user-menu-toggle {
            background: #F4F5F7;
            border: 1px solid #E2E8F0;
            color: var(--temu-text);
            padding: 7px 14px;
            border-radius: 20px;
            cursor: pointer;
            font-weight: 700;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 8px;
            transition: all 0.2s;
        }

        .user-menu-toggle:hover {
            background: #FFFFFF;
            border-color: var(--temu-orange);
        }

        .super-admin-badge {
            background: #DC2626;
            color: white;
            font-size: 0.62rem;
            padding: 2px 6px;
            border-radius: 4px;
            font-weight: 800;
        }

        .user-menu-dropdown {
            position: absolute;
            top: calc(100% + 8px);
            right: 0;
            background: #FFFFFF;
            border: 1px solid #E5E7EB;
            box-shadow: 0 10px 30px rgba(0,0,0,0.12);
            border-radius: 12px;
            width: 240px;
            display: none;
            flex-direction: column;
            padding: 8px 0;
            z-index: 10000;
        }

        .user-menu-dropdown.open {
            display: flex;
        }

        .user-menu-dropdown a {
            padding: 8px 16px;
            color: #374151;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
            transition: background 0.15s;
        }

        .user-menu-dropdown a:hover {
            background: #F9FAFB;
            color: var(--temu-orange);
        }

        .menu-section-label {
            padding: 6px 16px;
            font-size: 0.7rem;
            font-weight: 800;
            text-transform: uppercase;
            color: #9CA3AF;
            letter-spacing: 0.5px;
        }

        .menu-divider {
            height: 1px;
            background: #F3F4F6;
            margin: 4px 0;
        }

        .btn-logout-menu {
            color: #EF4444 !important;
        }

        /* Row 2: Category Pills & Navigation */
        .nav-links {
            display: flex;
            align-items: center;
            gap: 12px;
            list-style: none;
            margin: 0;
            padding: 0;
            overflow-x: auto;
            scrollbar-width: none;
        }

        .nav-links::-webkit-scrollbar {
            display: none;
        }

        .nav-links li a {
            color: #333333;
            text-decoration: none;
            font-size: 0.85rem;
            font-weight: 700;
            padding: 5px 12px;
            border-radius: 16px;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all 0.2s;
        }

        .nav-links li a:hover {
            background: #FFFFFF;
            color: var(--temu-orange);
            box-shadow: 0 1px 4px rgba(0,0,0,0.05);
        }

        .nav-category-select {
            background: #FFFFFF;
            border: 1px solid #D1D5DB;
            color: #111111;
            padding: 6px 14px;
            border-radius: 16px;
            font-size: 0.85rem;
            font-weight: 700;
            cursor: pointer;
            outline: none;
            transition: border 0.2s;
        }

        .nav-category-select:focus {
            border-color: var(--temu-orange);
        }

        /* Guest Cart Banner */
        .guest-cart-banner {
            background: linear-gradient(90deg, #FFF4EB 0%, #FFE9D5 100%);
            color: #9A3412;
            padding: 10px 20px;
            font-size: 0.85rem;
            font-weight: 600;
            text-align: center;
            border-bottom: 1px solid rgba(251, 119, 1, 0.2);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            flex-wrap: wrap;
        }

        .guest-cart-banner a {
            background: var(--temu-orange);
            color: #FFFFFF;
            padding: 3px 12px;
            border-radius: 12px;
            text-decoration: none;
            font-size: 0.8rem;
            font-weight: 700;
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

        /* Notifications */
        #notificationContainer {
            position: fixed;
            top: 90px;
            right: 20px;
            z-index: 99999;
            display: flex;
            flex-direction: column;
            gap: 10px;
            max-width: 380px;
        }

        .notification {
            color: white;
            padding: 12px 18px;
            border-radius: 10px;
            box-shadow: 0 6px 20px rgba(0,0,0,0.18);
            display: flex;
            align-items: center;
            gap: 10px;
            font-weight: 600;
            font-size: 0.88rem;
        }
        .notification-success { background: #10B981; }
        .notification-info { background: #3B82F6; }
        .notification-warning { background: #F59E0B; }
        .notification-error { background: #EF4444; }

        
        /* =========================================================
           MOBILE-FIRST APP-LIKE RESPONSIVE NAVIGATION STYLES
           ========================================================= */
        .mobile-drawer-btn {
            display: none;
            background: transparent;
            border: none;
            color: #111111;
            font-size: 1.35rem;
            padding: 6px 8px;
            cursor: pointer;
            border-radius: 8px;
            align-items: center;
            justify-content: center;
            transition: background 0.2s;
        }

        .mobile-drawer-btn:active {
            background: #F1F5F9;
        }

        .mobile-seller-btn {
            display: none;
            align-items: center;
            justify-content: center;
            width: 36px;
            height: 36px;
            border-radius: 50%;
            background: var(--temu-orange-light);
            color: var(--temu-orange);
            font-size: 0.95rem;
            text-decoration: none;
            border: 1px solid rgba(251, 119, 1, 0.25);
        }

        /* Slide-out Mobile Drawer */
        .mobile-drawer-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100vw;
            height: 100vh;
            background: rgba(15, 23, 42, 0.6);
            backdrop-filter: blur(4px);
            z-index: 10001;
            display: none;
            opacity: 0;
            transition: opacity 0.3s ease;
        }

        .mobile-drawer-overlay.active {
            display: block;
            opacity: 1;
        }

        .mobile-side-drawer {
            position: fixed;
            top: 0;
            left: -320px;
            width: 300px;
            max-width: 86vw;
            height: 100vh;
            background: #FFFFFF;
            z-index: 10002;
            display: flex;
            flex-direction: column;
            box-shadow: 6px 0 30px rgba(0, 0, 0, 0.2);
            transition: transform 0.32s cubic-bezier(0.16, 1, 0.3, 1);
            overflow-y: auto;
            -webkit-overflow-scrolling: touch;
        }

        .mobile-side-drawer.active {
            transform: translateX(320px);
        }

        .drawer-header {
            padding: 16px 18px;
            background: #0F172A;
            color: #FFFFFF;
            display: flex;
            align-items: center;
            justify-content: space-between;
            border-bottom: 2px solid var(--temu-orange);
        }

        .drawer-brand {
            display: flex;
            align-items: center;
            gap: 8px;
            text-decoration: none;
        }

        .drawer-brand span {
            color: #FFFFFF;
            font-weight: 900;
            font-size: 1.25rem;
            letter-spacing: -0.5px;
        }

        .drawer-brand span em {
            color: var(--temu-orange);
            font-style: normal;
        }

        .drawer-close-btn {
            background: transparent;
            border: none;
            color: #94A3B8;
            font-size: 1.8rem;
            line-height: 1;
            cursor: pointer;
            padding: 0 4px;
        }

        .drawer-close-btn:hover {
            color: #FFFFFF;
        }

        .drawer-user-box {
            padding: 14px 18px;
            background: #F8FAFC;
            border-bottom: 1px solid #E2E8F0;
        }

        .drawer-user-card {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .drawer-avatar {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            background: var(--temu-orange);
            color: #FFFFFF;
            font-weight: 800;
            font-size: 1.2rem;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .drawer-user-name {
            font-weight: 800;
            font-size: 0.95rem;
            color: #0F172A;
        }

        .drawer-user-role {
            font-size: 0.75rem;
            color: #64748B;
            font-weight: 600;
            text-transform: uppercase;
        }

        .drawer-guest-box {
            text-align: center;
        }

        .drawer-guest-box p {
            margin: 0 0 10px 0;
            font-size: 0.85rem;
            color: #475569;
            font-weight: 600;
        }

        .drawer-auth-btns {
            display: flex;
            gap: 8px;
        }

        .btn-drawer-login {
            flex: 1;
            background: #0F172A;
            color: #FFFFFF;
            text-align: center;
            padding: 8px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.82rem;
            text-decoration: none;
        }

        .btn-drawer-register {
            flex: 1;
            background: var(--temu-orange);
            color: #FFFFFF;
            text-align: center;
            padding: 8px;
            border-radius: 8px;
            font-weight: 700;
            font-size: 0.82rem;
            text-decoration: none;
        }

        .drawer-menu-links {
            padding: 12px 10px;
            display: flex;
            flex-direction: column;
            gap: 2px;
            flex: 1;
        }

        .drawer-menu-links a {
            display: flex;
            align-items: center;
            gap: 14px;
            padding: 11px 14px;
            border-radius: 10px;
            color: #1E293B;
            text-decoration: none;
            font-weight: 700;
            font-size: 0.9rem;
            transition: all 0.15s;
        }

        .drawer-menu-links a i {
            width: 20px;
            text-align: center;
            font-size: 1rem;
            color: #64748B;
        }

        .drawer-menu-links a:hover,
        .drawer-menu-links a:active {
            background: #F1F5F9;
            color: var(--temu-orange);
        }

        .drawer-menu-links a:hover i {
            color: var(--temu-orange);
        }

        .drawer-divider {
            height: 1px;
            background: #E2E8F0;
            margin: 8px 12px;
        }

        .drawer-section-heading {
            font-size: 0.72rem;
            font-weight: 800;
            color: #94A3B8;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            padding: 6px 14px;
        }

        .drawer-logout-link {
            color: #EF4444 !important;
        }

        .drawer-logout-link i {
            color: #EF4444 !important;
        }

        @media (max-width: 768px) {
            html, body {
                width: 100vw !important;
                max-width: 100vw !important;
                overflow-x: hidden !important;
                position: relative !important;
            }

            .main-navbar {
                width: 100vw !important;
                max-width: 100vw !important;
                left: 0 !important;
                right: 0 !important;
                margin: 0 !important;
                box-sizing: border-box !important;
            }

            .navbar-row {
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }

            .temu-top-strip { display: none !important; }
            
            /* Navbar Header Row 1 on Mobile */
            .navbar-row-top {
                padding: 8px 10px !important;
                flex-wrap: wrap !important;
                gap: 8px !important;
                width: 100% !important;
                max-width: 100% !important;
                box-sizing: border-box !important;
            }

            .mobile-drawer-btn {
                display: flex !important;
            }

            .nav-brand-container {
                gap: 6px !important;
            }

            .nav-brand {
                font-size: 1.22rem !important;
                font-weight: 900 !important;
            }

            .header-logo {
                height: 30px !important;
            }

            .nav-brand-badge {
                display: none !important;
            }

            .nav-seller-pill {
                display: none !important;
            }

            .mobile-seller-btn {
                display: flex !important;
            }

            .navbar-actions {
                gap: 8px !important;
                margin-left: auto !important;
            }

            .nav-cart-link {
                padding: 6px 8px !important;
            }

            .cart-text {
                display: none !important;
            }

            .nav-cart-icon-wrap {
                font-size: 1.15rem !important;
            }

            .user-menu-toggle {
                padding: 6px 10px !important;
                font-size: 0.8rem !important;
            }

            .user-name-text {
                max-width: 70px;
                overflow: hidden;
                text-overflow: ellipsis;
                white-space: nowrap;
            }

            .btn-login {
                padding: 6px 12px !important;
                font-size: 0.8rem !important;
            }

            /* Full-width Search Input on Mobile */
            .header-search-box {
                order: 3 !important;
                width: 100% !important;
                flex: 1 1 100% !important;
                max-width: 100% !important;
                margin-top: 4px !important;
            }

            .search-input-wrap {
                border-width: 1.5px !important;
            }

            #globalProductSearch {
                padding: 8px 12px !important;
                font-size: 0.88rem !important;
            }

            .search-submit-btn {
                padding: 8px 16px !important;
            }

            .search-submit-btn span {
                display: none !important;
            }

            /* Navbar Row 2 (Categories / Sub-nav) on Mobile */
            .navbar-row-bottom {
                padding: 4px 10px !important;
                gap: 8px !important;
                overflow-x: auto !important;
                white-space: nowrap !important;
                -webkit-overflow-scrolling: touch !important;
                scrollbar-width: none !important;
            }

            .navbar-row-bottom::-webkit-scrollbar {
                display: none !important;
            }

            .nav-links {
                gap: 6px !important;
                flex-shrink: 0 !important;
            }

            .nav-links li a {
                font-size: 0.78rem !important;
                padding: 4px 10px !important;
                border-radius: 14px !important;
            }

            .nav-category-select {
                padding: 4px 10px !important;
                font-size: 0.78rem !important;
                border-radius: 14px !important;
                flex-shrink: 0 !important;
                max-width: 160px !important;
            }

            /* Body padding to accommodate sticky bottom navigation */
            body {
                padding-bottom: 64px !important;
            }
        }

        @media (max-width: 480px) {
            .navbar-row-top {
                padding: 6px 8px !important;
            }
            .nav-brand {
                font-size: 1.15rem !important;
            }
            .header-logo {
                height: 28px !important;
            }
        }
    </style>
</head>

<body>

    <!-- TEMU-STYLE TOP BENEFIT STRIP -->
    <div class="temu-top-strip">
        <div class="top-strip-items">
            <div class="top-strip-item">
                <i class="fas fa-truck-fast"></i>
                <span><strong>Free Delivery</strong> on orders over ৳1,000</span>
            </div>
            <div class="top-strip-item">
                <i class="fas fa-industry"></i>
                <span><strong>Factory Direct</strong> Old Dhaka wholesale pricing</span>
            </div>
            <div class="top-strip-item">
                <i class="fas fa-shield-halved"></i>
                <span><strong>Packbang Protection</strong> 100% Quality guarantee</span>
            </div>
            <div class="top-strip-item">
                <i class="fas fa-bolt"></i>
                <span><strong>Lightning Deals</strong> Up to 70% OFF</span>
            </div>
        </div>
    </div>

    <!-- MAIN NAVBAR -->
    <nav class="main-navbar">
        <!-- Row 1: Brand, Search, Cart, Account -->
        <div class="navbar-row navbar-row-top">
            <button type="button" class="mobile-drawer-btn" id="mobileDrawerOpen" aria-label="Open Navigation">
                <i class="fas fa-bars"></i>
            </button>
            <a href="/" class="nav-brand-container">
                <img src="https://res.cloudinary.com/o4zunnbp/image/upload/v1791517536/packbanglogo_molbe0.png" alt="PACKBANG Logo" class="header-logo" />
                <span class="nav-brand">
                    PACKBANG
                    <span class="nav-brand-badge">DIRECT</span>
                </span>
            </a>

            <!-- Search (Temu Style) -->
            <div class="header-search-box">
                <div class="search-input-wrap">
                    <span class="search-icon-placeholder">🔍</span>
                    <input type="text" id="globalProductSearch" placeholder="Search courier poly, bubble wrap, carton boxes, stickers..." autocomplete="off" />
                    <button type="button" class="search-submit-btn" onclick="$('#globalProductSearch').trigger('keyup')">
                        <i class="fas fa-search"></i>
                        <span>Search</span>
                    </button>
                </div>
            </div>

            <div class="navbar-actions">
                <a href="https://seller.packbang.com/" class="mobile-seller-btn" title="Seller Hub">
                    <i class="fas fa-store"></i>
                </a>
                <a href="https://seller.packbang.com/" class="nav-seller-pill">
                    <i class="fas fa-store"></i> Seller Hub
                </a>

                <a href="/cart" class="nav-cart-link" id="cartLink">
                    <div class="nav-cart-icon-wrap">
                        <i class="fas fa-shopping-cart"></i>
                        <span class="cart-badge zero" id="cartCount">0</span>
                    </div>
                    <span class="cart-text">Cart</span>
                </a>

                <% if (typeof user !== 'undefined' && user) { %>
                    <div class="user-menu">
                        <button type="button" class="user-menu-toggle" id="userMenuToggle">
                            <i class="fas fa-user-circle"></i>
                            <span class="user-name-text"><%= user.username %></span>
                            <% if (user.isSuperAdmin === true || user.username === 'superadmin') { %>
                                <span class="super-admin-badge">Super</span>
                            <% } %>
                            <i class="fas fa-chevron-down"></i>
                        </button>

                        <div class="user-menu-dropdown" id="userMenuDropdown">
                            <div class="menu-section-label">Your account</div>
                            <a href="/profile"><i class="fas fa-user-circle"></i> Profile</a>
                            <a href="/my-orders"><i class="fas fa-box"></i> My Orders</a>
                            <a href="/my-custom-orders"><i class="fas fa-list-ul"></i> My Custom Orders</a>

                            <% if (user.role === 'seller' || user.role === 'authorized_cashier' || user.isSuperAdmin === true) { %>
                                <div class="menu-divider"></div>
                                <div class="menu-section-label">Seller tools</div>
                                <a href="/seller/custom-orders"><i class="fas fa-gavel"></i> Bid on Orders</a>
                            <% } %>

                            <% if (user.role === 'admin' || user.role === 'authorized_cashier' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true) { %>
                                <div class="menu-divider"></div>
                                <div class="menu-section-label">Point of sale</div>
                                <a href="/terminal"><i class="fas fa-cash-register"></i> Terminal</a>
                            <% } %>

                            <% if (user.role === 'admin' || user.username.toLowerCase() === 'admin' || user.isSuperAdmin === true) { %>
                                <div class="menu-divider"></div>
                                <div class="menu-section-label">Store management</div>
                                <a href="/admin/sellers"><i class="fas fa-store"></i> Seller Management</a>
                                <a href="/admin/custom-orders"><i class="fas fa-clipboard-list"></i> Review Custom Orders</a>
                                <a href="/admin/orders"><i class="fas fa-clipboard-list"></i> Order Management</a>
                                <a href="/admin/inventory"><i class="fas fa-warehouse"></i> Inventory</a>
                                <a href="/sales"><i class="fas fa-chart-bar"></i> Sales</a>
                                <a href="/admin/categories"><i class="fas fa-tags"></i> Categories</a>
                                <a href="/admin/stock-report"><i class="fas fa-boxes"></i> Stock Report</a>
                                <a href="/admin/users"><i class="fas fa-users"></i> Users</a>
                                <a href="/admin/banners"><i class="fas fa-images"></i> Banners</a>
                            <% } %>

                            <% if (user.username === 'superadmin' || user.isSuperAdmin === true) { %>
                                <div class="menu-divider"></div>
                                <div class="menu-section-label">Super admin</div>
                                <a href="/superadmin/dashboard"><i class="fas fa-crown"></i> Super Dashboard</a>
                                <a href="/superadmin/admins"><i class="fas fa-user-shield"></i> Manage Admins</a>
                            <% } %>

                            <div class="menu-divider"></div>
                            <a href="/logout" class="btn-logout-menu"><i class="fas fa-sign-out-alt"></i> Logout</a>
                        </div>
                    </div>
                <% } else { %>
                    <a href="/login" class="btn-login">
                        <i class="fas fa-user"></i> Login
                    </a>
                <% } %>
            </div>
        </div>

        <!-- Row 2: Navigation & Categories -->
        <div class="navbar-row navbar-row-bottom">
            <ul class="nav-links">
                <li><a href="/"><i class="fas fa-house"></i> Home</a></li>
                <li><a href="/#lightning-deals"><i class="fas fa-bolt" style="color:var(--temu-orange);"></i> Lightning Deals</a></li>
                <li><a href="/custom-orders"><i class="fas fa-pencil-ruler"></i> Custom Orders</a></li>
                <li><a href="/#categories"><i class="fas fa-border-all"></i> Categories</a></li>
                <li><a href="/#factory-direct"><i class="fas fa-industry"></i> Factory Direct</a></li>
            </ul>

            <label for="Categories" class="visually-hidden" style="position:absolute; left:-9999px;">Select a Category</label>
            <select name="Categories" id="Categories" class="nav-category-select" onchange="if(this.value) window.location.href='/?category='+this.value">
                <option value="">All Packaging Categories</option>
                <% if (typeof categories !== 'undefined' && categories && categories.length > 0) { %>
                    <% categories.forEach(parent => { %>
                        <% if (!parent.children || parent.children.length === 0) { %>
                            <option value="<%= parent._id %>" <%= (typeof currentCategory !== 'undefined' && currentCategory === parent._id.toString()) ? 'selected' : '' %>>
                                <%= parent.name %>
                            </option>
                        <% } else { %>
                            <optgroup label="<%= parent.name %>">
                                <% parent.children.forEach(child => { %>
                                    <option value="<%= child._id %>" <%= (typeof currentCategory !== 'undefined' && currentCategory === child._id.toString()) ? 'selected' : '' %>>
                                        <%= child.name %>
                                    </option>
                                <% }) %>
                            </optgroup>
                        <% } %>
                    <% }) %>
                <% } %>
            </select>
        </div>
    </nav>

    <!-- MOBILE SIDE DRAWER -->
    <div id="mobileDrawerOverlay" class="mobile-drawer-overlay"></div>
    <aside id="mobileSideDrawer" class="mobile-side-drawer">
        <div class="drawer-header">
            <a href="/" class="drawer-brand">
                <span>PACKBANG <em>DIRECT</em></span>
            </a>
            <button type="button" class="drawer-close-btn" id="mobileDrawerClose" aria-label="Close Menu">&times;</button>
        </div>

        <div class="drawer-user-box">
            <% if (typeof user !== 'undefined' && user) { %>
                <div class="drawer-user-card">
                    <div class="drawer-avatar"><%= (user.username || 'U').charAt(0).toUpperCase() %></div>
                    <div>
                        <div class="drawer-user-name"><%= user.username %></div>
                        <div class="drawer-user-role"><%= user.role || 'Member' %></div>
                    </div>
                </div>
            <% } else { %>
                <div class="drawer-guest-box">
                    <p>Welcome to Packbang Direct Wholesale!</p>
                    <div class="drawer-auth-btns">
                        <a href="/login" class="btn-drawer-login"><i class="fas fa-sign-in-alt"></i> Login</a>
                        <a href="/register" class="btn-drawer-register"><i class="fas fa-user-plus"></i> Register</a>
                    </div>
                </div>
            <% } %>
        </div>

        <div class="drawer-menu-links">
            <a href="/"><i class="fas fa-house"></i> Home</a>
            <a href="/#lightning-deals"><i class="fas fa-bolt" style="color:var(--temu-orange);"></i> Lightning Deals</a>
            <a href="/custom-orders"><i class="fas fa-pencil-ruler"></i> Custom Packaging Orders</a>
            <a href="/make-custom-order"><i class="fas fa-plus-circle"></i> Create Custom Order</a>
            <a href="/#categories"><i class="fas fa-border-all"></i> All Categories</a>
            <a href="https://seller.packbang.com/"><i class="fas fa-store" style="color:var(--temu-orange);"></i> Seller Hub Portal</a>
            <a href="/track-order"><i class="fas fa-truck"></i> Track Order</a>

            <% if (typeof user !== 'undefined' && user) { %>
                <div class="drawer-divider"></div>
                <div class="drawer-section-heading">My Account</div>
                <a href="/profile"><i class="fas fa-id-card"></i> Profile & Address</a>
                <a href="/my-orders"><i class="fas fa-box"></i> My Orders</a>
                <a href="/my-custom-orders"><i class="fas fa-list-ul"></i> My Custom Orders</a>

                <% if (user.role === 'admin' || user.role === 'superadmin' || user.username === 'admin') { %>
                    <div class="drawer-divider"></div>
                    <div class="drawer-section-heading">Store Management</div>
                    <a href="/admin/sellers"><i class="fas fa-store"></i> Seller Management</a>
                    <a href="/admin/custom-orders"><i class="fas fa-clipboard-list"></i> Review Custom Orders</a>
                    <a href="/admin/orders"><i class="fas fa-shopping-bag"></i> Orders</a>
                    <a href="/admin/inventory"><i class="fas fa-warehouse"></i> Inventory</a>
                    <a href="/sales"><i class="fas fa-chart-bar"></i> Sales Report</a>
                <% } %>

                <div class="drawer-divider"></div>
                <a href="/logout" class="drawer-logout-link"><i class="fas fa-sign-out-alt"></i> Logout</a>
            <% } %>
        </div>
    </aside>
    

    <% if (typeof user === 'undefined' || !user) { %>
        <div class="guest-cart-banner">
            <i class="fas fa-bolt" style="color:var(--temu-orange);"></i>
            <span>Factory Direct Bulk Pricing Unlocked! You have <strong id="guestCartCount">0</strong> items in cart.</span>
            <a href="/login">Checkout Now <i class="fas fa-arrow-right"></i></a>
        </div>
    <% } %>

    <div id="notificationContainer"></div>

    <script>
        $(document).ready(function() {
            // Mobile Drawer Toggle
            $('#mobileDrawerOpen').on('click', function() {
                $('#mobileSideDrawer').addClass('active');
                $('#mobileDrawerOverlay').addClass('active');
                $('body').css('overflow', 'hidden');
            });

            $('#mobileDrawerClose, #mobileDrawerOverlay').on('click', function() {
                $('#mobileSideDrawer').removeClass('active');
                $('#mobileDrawerOverlay').removeClass('active');
                $('body').css('overflow', '');
            });

            $('.drawer-menu-links a').on('click', function() {
                $('#mobileSideDrawer').removeClass('active');
                $('#mobileDrawerOverlay').removeClass('active');
                $('body').css('overflow', '');
            });
    
            $('#userMenuToggle').on('click', function(e) {
                e.stopPropagation();
                $('#userMenuDropdown').toggleClass('open');
            });

            $('#userMenuDropdown').on('click', function(e) {
                e.stopPropagation();
            });

            $(document).on('click', function() {
                $('#userMenuDropdown').removeClass('open');
            });

            $(document).on('keyup', function(e) {
                if (e.key === 'Escape') {
                    $('#userMenuDropdown').removeClass('open');
                }
            });

            $('#globalProductSearch').on('keyup', function() {
                var searchString = $(this).val().toLowerCase().trim();

                $('.home-catalog-grid .home-card').filter(function() {
                    var productNameText = $(this).find('.product-name, strong').text().toLowerCase();
                    $(this).toggle(productNameText.indexOf(searchString) > -1);
                });

                $('.product-grid .card, .admin-inventory-grid .card').filter(function() {
                    var nameText = $(this).find('strong, .product-name').text().toLowerCase();
                    $(this).toggle(nameText.indexOf(searchString) > -1);
                });
            });

            window.updateCartCount = function() {
                $.ajax({
                    url: '/api/cart/view',
                    type: 'GET',
                    success: function(response) {
                        if (response.success) {
                            var count = response.count || 0;
                            var $badge = $('#cartCount');
                            $badge.text(count);
                            $('#guestCartCount').text(count);

                            if (count === 0) {
                                $badge.addClass('zero');
                            } else {
                                $badge.removeClass('zero');
                            }
                        }
                    },
                    error: function() {
                        console.log('Cart count update failed');
                    }
                });
            };

            window.showNotification = function(message, type, icon) {
                var container = $('#notificationContainer');
                var icons = {
                    success: 'fa-check-circle',
                    info: 'fa-info-circle',
                    warning: 'fa-exclamation-triangle',
                    error: 'fa-times-circle'
                };
                var notification = $(
                    '<div class="notification notification-' + type + '">' +
                        '<i class="fas ' + (icons[type] || 'fa-info-circle') + '"></i>' +
                        '<span>' + message + '</span>' +
                    '</div>'
                );
                container.append(notification);
                setTimeout(function() {
                    notification.fadeOut(300, function() { $(this).remove(); });
                }, 3000);
            };

            if (typeof updateCartCount === 'function') {
                updateCartCount();
            }

            console.log('✅ Temu-style Header Loaded with Live Cart Sync!');
        });
    </script>
