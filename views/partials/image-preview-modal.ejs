<!-- ========================================== -->
<!-- UNIVERSAL ORDER IMAGE PREVIEW MODAL -->
<!-- Matches admin/sellers document preview modal -->
<!-- ========================================== -->
<div id="orderImagePreviewModal" class="img-preview-modal-overlay" style="display: none;" onclick="closeOrderImagePreview(event)">
    <div class="img-preview-modal-box" onclick="event.stopPropagation()">
        <div class="img-preview-modal-header">
            <div style="display: flex; align-items: center; gap: 10px;">
                <span style="font-size: 20px;">🖼️</span>
                <h3 id="orderImgModalTitle" style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #0F172A;">
                    Packaging Specification Preview
                </h3>
            </div>
            <button type="button" class="img-preview-close-btn" onclick="closeOrderImagePreview()" aria-label="Close preview">✕</button>
        </div>
        
        <div class="img-preview-body">
            <img id="orderImgModalSrc" src="" alt="Custom Order Specification" />
        </div>

        <div class="img-preview-modal-footer">
            <span class="img-preview-tip"><i class="fas fa-info-circle"></i> High-resolution specification blueprint / sample</span>
            <div style="display: flex; gap: 8px;">
                <button type="button" class="tab-btn" onclick="rotatePreviewImg()" style="background: #F1F5F9; color: #334155; border: 1px solid #CBD5E1; padding: 6px 14px; border-radius: 6px; font-weight: 700; cursor: pointer; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fas fa-redo"></i> Rotate
                </button>
                <a id="orderImgModalLink" href="" target="_blank" class="tab-btn" style="background: #0F172A; color: #FFFFFF; text-decoration: none; padding: 6px 16px; border-radius: 6px; font-weight: 700; display: inline-flex; align-items: center; gap: 6px;">
                    <i class="fas fa-external-link-alt"></i> Open Full Original
                </a>
            </div>
        </div>
    </div>
</div>

<style>
.img-preview-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(15, 23, 42, 0.85);
    backdrop-filter: blur(5px);
    display: none;
    align-items: center;
    justify-content: center;
    z-index: 9999999;
    padding: 20px;
    box-sizing: border-box;
    animation: imgFadeIn 0.2s ease-out;
}

@keyframes imgFadeIn {
    from { opacity: 0; }
    to { opacity: 1; }
}

.img-preview-modal-box {
    background: #FFFFFF;
    border-radius: 16px;
    padding: 20px 24px;
    width: 100%;
    max-width: 840px;
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.4);
    box-sizing: border-box;
    display: flex;
    flex-direction: column;
}

.img-preview-modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 12px;
    border-bottom: 1px solid #F1F5F9;
}

.img-preview-close-btn {
    background: #F1F5F9;
    border: none;
    width: 34px;
    height: 34px;
    border-radius: 50%;
    font-size: 1.25rem;
    cursor: pointer;
    color: #475569;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.15s;
}
.img-preview-close-btn:hover {
    background: #E2E8F0;
    color: #0F172A;
}

.img-preview-body {
    text-align: center;
    background: #0F172A;
    border-radius: 12px;
    overflow: hidden;
    max-height: 72vh;
    min-height: 250px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    border: 1px solid #334155;
}

.img-preview-body img {
    max-width: 100%;
    max-height: 72vh;
    object-fit: contain;
    transition: transform 0.2s ease;
}

.img-preview-modal-footer {
    margin-top: 14px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 10px;
}

.img-preview-tip {
    font-size: 0.82rem;
    color: #64748B;
}

/* Reusable Interactive Image Thumbnails */
.order-images {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
    margin: 10px 0;
}

.order-img-thumb-wrap {
    position: relative;
    width: 84px;
    height: 84px;
    border-radius: 10px;
    overflow: hidden;
    cursor: pointer;
    border: 2px solid #E2E8F0;
    transition: all 0.2s ease;
    background: #F8FAFC;
    flex-shrink: 0;
}

.order-img-thumb-wrap:hover {
    border-color: #FF5A1F;
    transform: translateY(-2px);
    box-shadow: 0 4px 14px rgba(255, 90, 31, 0.25);
}

.order-img-thumb-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
}

.order-img-thumb-wrap .img-zoom-hint {
    position: absolute;
    inset: 0;
    background: rgba(15, 23, 42, 0.5);
    color: #FFFFFF;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    opacity: 0;
    transition: opacity 0.2s;
}

.order-img-thumb-wrap:hover .img-zoom-hint {
    opacity: 1;
}
</style>

<script>
let currentPreviewRotation = 0;

function openOrderImagePreview(imgUrl, title) {
    if (!imgUrl) return;
    const modal = document.getElementById('orderImagePreviewModal');
    const imgEl = document.getElementById('orderImgModalSrc');
    const linkEl = document.getElementById('orderImgModalLink');
    const titleEl = document.getElementById('orderImgModalTitle');

    if (!modal || !imgEl) return;

    currentPreviewRotation = 0;
    imgEl.style.transform = 'rotate(0deg)';
    imgEl.src = imgUrl;
    if (linkEl) linkEl.href = imgUrl;
    if (titleEl) titleEl.innerText = title || 'Packaging Specification Preview';

    modal.style.display = 'flex';
}

function closeOrderImagePreview(e) {
    if (!e || e.target.id === 'orderImagePreviewModal' || e.target.tagName === 'BUTTON' || (e.target.classList && e.target.classList.contains('img-preview-close-btn'))) {
        const modal = document.getElementById('orderImagePreviewModal');
        if (modal) modal.style.display = 'none';
    }
}

function rotatePreviewImg() {
    const imgEl = document.getElementById('orderImgModalSrc');
    if (!imgEl) return;
    currentPreviewRotation = (currentPreviewRotation + 90) % 360;
    imgEl.style.transform = 'rotate(' + currentPreviewRotation + 'deg)';
}

document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
        const modal = document.getElementById('orderImagePreviewModal');
        if (modal && modal.style.display === 'flex') {
            modal.style.display = 'none';
        }
    }
});
</script>
