<script>
// Global Trader Profile Modal Handler
async function openTraderProfileModal(sellerId, fallbackName) {
    const modal = document.getElementById('traderProfileModal');
    if (!modal) return;
    modal.style.display = 'flex';

    // Set initial loading values
    document.getElementById('tModalName').textContent = fallbackName || 'Verified Supplier';
    document.getElementById('tModalAvatar').innerHTML = (fallbackName ? fallbackName.charAt(0).toUpperCase() : 'P') + '<span class="t-online-dot"></span>';
    document.getElementById('tModalEmptyReviews').style.display = 'block';
    document.getElementById('tModalEmptyReviews').textContent = 'Loading verified feedback...';
    document.getElementById('tModalReviewsList').innerHTML = '<div class="t-empty-reviews">Loading verified feedback...</div>';

    try {
        const queryId = encodeURIComponent(sellerId || 'admin');
        const queryName = encodeURIComponent(fallbackName || '');
        const res = await fetch('/api/trader/' + queryId + '/profile?name=' + queryName);
        const data = await res.json();

        if (data.success && data.trader) {
            const t = data.trader;
            document.getElementById('tModalName').textContent = t.sellerName;
            document.getElementById('tModalAvatar').innerHTML = t.avatarChar + '<span class="t-online-dot"></span>';
            document.getElementById('tModalBadge').textContent = t.badge;
            document.getElementById('tModalTier').textContent = t.isVerified ? 'Verified Platform Partner' : 'Standard Supplier';
            document.getElementById('tModalSince').textContent = t.memberSince || '2024';

            document.getElementById('tModalTrades').textContent = Number(t.tradesCount).toLocaleString();
            document.getElementById('tModalCompletion').textContent = t.completionRate + '%';
            document.getElementById('tModalPositive').textContent = '👍 ' + t.positiveFeedbackRate + '%';
            document.getElementById('tModalRating').textContent = '⭐ ' + t.averageRating;

            // Categories
            const catContainer = document.getElementById('tModalCategories');
            if (catContainer && t.categories) {
                catContainer.innerHTML = t.categories.map(c => '<span class="t-tag">' + c + '</span>').join('');
            }

            // Reviews
            const reviewsCountEl = document.getElementById('tModalReviewCount');
            if (reviewsCountEl) reviewsCountEl.textContent = t.reviews ? t.reviews.length : '0';

            const listEl = document.getElementById('tModalReviewsList');
            if (t.reviews && t.reviews.length > 0) {
                listEl.innerHTML = t.reviews.map(r => {
                    const stars = '★'.repeat(r.rating) + '☆'.repeat(5 - r.rating);
                    const dateStr = new Date(r.createdAt).toLocaleDateString();
                    const itemDesc = r.reviewType === 'custom_order' ? ('Custom Order: ' + (r.customOrderTitle || 'Packaging Batch')) : (r.productName || 'Packaging Item');
                    return '<div class="t-review-card">' +
                        '<div class="t-review-top">' +
                            '<span class="t-review-user">' + r.userName + ' <span class="t-verified-check">✓ Verified Buyer</span></span>' +
                            '<span class="t-review-stars">' + stars + '</span>' +
                        '</div>' +
                        '<p class="t-review-body">"' + escapeHtml(r.comment) + '"</p>' +
                        '<div class="t-review-date"><small>' + itemDesc + ' • ' + dateStr + '</small></div>' +
                    '</div>';
                }).join('');
            } else {
                listEl.innerHTML = '<div class="t-empty-reviews">No customer reviews yet. This trader maintains a 100% dispute-free record.</div>';
            }
        }
    } catch (err) {
        console.warn('Failed to load trader profile:', err);
    }
}

function closeTraderProfileModal() {
    const modal = document.getElementById('traderProfileModal');
    if (modal) modal.style.display = 'none';
}

function escapeHtml(text) {
    if (!text) return '';
    return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
}
</script>
