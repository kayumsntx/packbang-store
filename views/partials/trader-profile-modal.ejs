<!-- ========================================== -->
<!-- TRADER PROFILE DETAILS MODAL (SAFE PLATFORM TRADER) -->
<!-- Strictly displays performance, verified ratings & reviews without contact info -->
<!-- ========================================== -->
<div id="traderProfileModal" class="trader-modal-overlay" style="display: none;" onclick="if(event.target === this) closeTraderProfileModal();">
    <div class="trader-modal-card">
        <!-- Close Button -->
        <button type="button" class="trader-modal-close-btn" onclick="closeTraderProfileModal()" aria-label="Close modal">&times;</button>

        <!-- Trader Header -->
        <div class="trader-modal-header">
            <div class="trader-avatar-circle" id="tModalAvatar">P<span class="t-online-dot"></span></div>
            <div class="trader-header-text">
                <div class="trader-title-line">
                    <h3 id="tModalName">PackBang Direct</h3>
                    <span class="trader-verified-star" title="Platform Verified Supplier">✦</span>
                    <span class="trader-badge-pill" id="tModalBadge">Verified Supplier</span>
                </div>
                <div class="trader-sub-line">
                    <span id="tModalTier">Authenticated Partner</span> • 
                    <span>Member Since <span id="tModalSince">2024</span></span>
                </div>
            </div>
        </div>

        <!-- 4-Metric Performance Grid (Matches Image: Trades, Completion Rate, Positive %) -->
        <div class="trader-metrics-grid">
            <div class="trader-metric-box">
                <div class="t-metric-label">Fulfilled Trades</div>
                <div class="t-metric-value" id="tModalTrades">3,087</div>
                <div class="t-metric-sub">Platform Orders</div>
            </div>
            <div class="trader-metric-box">
                <div class="t-metric-label">Completion Rate</div>
                <div class="t-metric-value highlight" id="tModalCompletion">99.80%</div>
                <div class="t-metric-sub">On-Time Delivery</div>
            </div>
            <div class="trader-metric-box">
                <div class="t-metric-label">Positive Feedback</div>
                <div class="t-metric-value green" id="tModalPositive">👍 99.88%</div>
                <div class="t-metric-sub">Buyer Satisfaction</div>
            </div>
            <div class="trader-metric-box">
                <div class="t-metric-label">Average Rating</div>
                <div class="t-metric-value gold" id="tModalRating">⭐ 4.95</div>
                <div class="t-metric-sub">5-Star Standard</div>
            </div>
        </div>

        <!-- Platform Safety & Anti-Contract Warning Banner -->
        <div class="trader-safety-banner">
            <div class="t-safety-icon">🛡️</div>
            <div class="t-safety-text">
                <strong>PackBang Safe Marketplace Policy</strong>
                <p>All packaging orders, escrow payments, and product warranties are exclusively guaranteed on PackBang. Sharing direct phone numbers, emails, or off-platform contracts is strictly prohibited to protect all members from fraud.</p>
            </div>
        </div>

        <!-- Specialized Categories -->
        <div class="trader-categories-section">
            <span class="t-sec-title">Factory Packaging Specialization:</span>
            <div class="t-categories-tags" id="tModalCategories">
                <span class="t-tag">Corrugated Cartons</span>
                <span class="t-tag">Courier Poly Bags</span>
                <span class="t-tag">Bubble Wrap & Cushioning</span>
            </div>
        </div>

        <!-- Verified Customer Reviews Section -->
        <div class="trader-reviews-section">
            <div class="t-reviews-header">
                <h4>Verified Customer Reviews & Feedback (<span id="tModalReviewCount">0</span>)</h4>
                <span class="t-safe-badge"><i class="fas fa-lock"></i> Protected Transactions</span>
            </div>
            <div class="t-reviews-list" id="tModalReviewsList">
                <div class="t-empty-reviews" id="tModalEmptyReviews">
                    Loading verified feedback...
                </div>
            </div>
        </div>
    </div>
</div>

